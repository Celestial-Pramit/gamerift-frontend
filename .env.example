VITE_API_URL=http://localhost:9090/api
# WebSocket URL for notifications. If not set, derives from VITE_API_URL (http->ws, https->wss, strip /api).
# Example: VITE_WS_URL=ws://localhost:9090/ws
VITE_WS_URL=
# true = fake data (no backend needed). false = real backend.
VITE_USE_MOCK=true
# Only used when VITE_USE_MOCK=false.
# true = OTP, forgot and reset screens stay fake. false (needs backend Phase 7 part 1) = they use the real backend.
VITE_MOCK_OTP=true
